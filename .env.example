# Copy this file to .env.local and fill in real values.
# Never commit real secrets — this file documents which vars exist, not their values.

# ── Client-side (exposed to the browser, must be prefixed VITE_) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# ── Supabase (server-side only) ──
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (server-side only, calls api.stripe.com directly) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Telnyx (Lanavix's own platform-owned account — one API key,
#    shared across every business's auto-provisioned number) ──
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_CONNECTION_ID=

# Shared secret Vercel Cron sends as a bearer token to authenticate /api/cron/* routes
CRON_SECRET=

# ── AI / data providers ──
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=

# ── Monday.com CRM sync (optional — sync calls fail silently if unset) ──
MONDAY_API_KEY=
MONDAY_LEAD_BOARD_ID=

# ── Outbound email (optional — contact-form notifications log instead of
#    sending if unset; see src/lib/email.server.ts) ──
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFICATION_EMAIL=
